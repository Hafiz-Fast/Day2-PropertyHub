<% content_for :title do %>
  Edit Profile
<% end %>

<div class="max-w-md mx-auto py-12"><div class="app-surface app-card sm:p-8"><p class="app-eyebrow mb-2">Account</p><h1 class="text-3xl font-bold mb-6">Edit profile</h1>

  <%= form_with model: @user do |f| %>
    <div class="mb-4">
      <%= f.label :name, nil, class: "app-label" %>
      <%= f.text_field :name, class: "app-input" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, nil, class: "app-label" %>
      <%= f.email_field :email, class: "app-input" %>
    </div>

    <div class="mb-6">
      <%= f.label :password, nil, class: "app-label" %>
      <%= f.password_field :password, class: "app-input" %>
    </div>

    <%= f.submit "Save changes", class: "app-button app-button-primary cursor-pointer" %>
  <% end %>
</div></div>
