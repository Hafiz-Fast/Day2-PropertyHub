<% content_for :title do %>
  <%= @user.name %>
<% end %>

<div class="max-w-2xl mx-auto py-8 app-surface app-card sm:p-8"><p class="app-eyebrow mb-2">Community profile</p>
  <h1 class="text-3xl font-bold"><%= @user.name %></h1>
  <p class="app-muted mt-2"><%= @user.email %></p>

  <div class="mt-6">
    <%= link_to "Edit profile", edit_user_path(@user), class: "app-button app-button-primary" %>
    <%= link_to "Back to community", users_path, class: "app-link ml-3 font-semibold" %>
  </div>
</div>
