<% content_for :title, "My account" %>

<div class="max-w-md mx-auto py-12">
  <div class="app-surface app-card sm:p-8">
    <p class="app-eyebrow mb-2">Account</p>
    <h1 class="text-3xl font-bold mb-6">Manage account</h1>

    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :patch do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :name, class: "app-label" %>
        <%= f.text_field :name, autocomplete: "name", class: "app-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :age, class: "app-label" %>
        <%= f.number_field :age, min: 0, autocomplete: "bday", class: "app-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :email, class: "app-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "app-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "New password", class: "app-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "app-input" %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, class: "app-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "app-input" %>
      </div>

      <div class="mb-6">
        <%= f.label :current_password, class: "app-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "app-input" %>
        <p class="app-muted mt-1 text-sm">Required to save account or password changes.</p>
      </div>

      <%= f.submit "Save changes", class: "app-button app-button-primary cursor-pointer" %>
    <% end %>
  </div>
</div>
