<%= turbo_frame_tag dom_id(property) do %>

  <article class="app-surface app-card app-card-hover" data-controller="property-details" aria-expanded="false">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="app-eyebrow mb-2">Listed property</p>
        <h2 class="text-2xl font-semibold tracking-tight">
          <%= link_to property.title, property_path(property), class: "hover:app-brand", data: { turbo_frame: "_top" } %>
        </h2>

        <p class="app-muted mt-2">By <%= property.user.name %> · <%= property_location(property) %></p>

        <p class="mt-3 text-lg font-bold app-brand">
          <%= formatted_price(property) %>
        </p>
      </div>

      <button type="button" class="app-button" data-action="click->property-details#toggle" data-property-details-target="button">
        <span data-property-details-target="label">View details</span>
      </button>
    </div>

    <div class="app-card-details mt-5 pt-4" hidden data-property-details-target="details">
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <p class="text-sm uppercase tracking-[0.18em] app-muted">Bedrooms</p>
          <p class="font-semibold mt-1">
            <%= property.bedrooms.presence || "Not listed" %>
          </p>
        </div>

        <div>
          <p class="text-sm uppercase tracking-[0.18em] app-muted">Published</p>
          <p class="font-semibold mt-1">
            <%= time_ago_in_words(property.created_at) %> ago
          </p>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <%= button_to favorite_property_path(property), method: :post, class: "app-button #{'app-button-primary' if favorited_property?(property)}", form: { data: { turbo_frame: "_top" } } do %>
          <%= favorited_property?(property) ? "♥ Saved" : "♡ Save property" %>
        <% end %>
        <%= link_to "Open full listing", property_path(property), class: "app-button app-button-primary", data: { turbo_frame: "_top" } %>
        <span class="app-muted text-sm">View reviews and manage this listing.</span>
      </div>
    </div>
  </article>

<% end %>
