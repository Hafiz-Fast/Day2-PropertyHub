<% content_for :title, @property.title %>

<div class="max-w-4xl mx-auto py-4">
  <%= link_to "← Back to listings", properties_path, class: "app-link text-sm font-semibold" %>
  <article class="app-surface app-card mt-5 sm:p-8">
    <p class="app-eyebrow mb-3">Property listing</p>
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
      <div><h1 class="text-3xl font-bold tracking-tight sm:text-4xl"><%= @property.title %></h1><p class="app-muted mt-3 text-lg"><%= @property.location %> · Listed by <%= @property.user.name %></p></div>
      <p class="text-2xl font-bold app-brand whitespace-nowrap"><%= formatted_price(@property) %></p>
    </div>
    <div class="mt-7 grid gap-4 border-y py-5 sm:grid-cols-2" style="border-color: var(--app-border)"><div><p class="app-eyebrow">Bedrooms</p><p class="mt-1 font-semibold"><%= @property.bedrooms.presence || "Not listed" %></p></div><div><p class="app-eyebrow">Published</p><p class="mt-1 font-semibold"><%= time_ago_in_words(@property.created_at) %> ago</p></div></div>
    <div class="mt-6 flex flex-wrap gap-3"><%= button_to favorite_property_path(@property), method: :post, class: "app-button #{'app-button-primary' if favorited_property?(@property)}" do %><%= favorited_property?(@property) ? "♥ Saved" : "♡ Save property" %><% end %><%= link_to "Edit listing", edit_property_path(@property), class: "app-button app-button-primary" %><%= button_to "Delete listing", @property, method: :delete, data: { turbo_confirm: "Delete this property listing?" }, class: "app-button text-red-600" %></div>
  </article>

  <section class="mt-8"><div class="flex items-center justify-between"><div><p class="app-eyebrow mb-1">Feedback</p><h2 class="text-2xl font-bold">Reviews</h2></div><span class="app-muted text-sm"><%= @property.reviews.count %> total</span></div>
    <div class="mt-4 space-y-3"><% if @property.reviews.any? %><% @property.reviews.each do |review| %><article class="app-surface rounded-2xl p-5"><div class="flex items-center justify-between"><p class="font-semibold">Anonymous reviewer</p><p class="font-semibold app-brand"><%= review.rating %>/5</p></div><p class="app-muted mt-2"><%= review.comment %></p><%= button_to "Delete review", property_review_path(@property, review), method: :delete, data: { turbo_confirm: "Delete this review?" }, class: "mt-3 text-sm font-semibold text-red-600" %></article><% end %><% else %><div class="app-surface rounded-2xl p-6 text-center app-muted">No reviews yet. Be the first to share feedback.</div><% end %></div>
  </section>

  <section class="app-surface app-card mt-8 sm:p-7"><p class="app-eyebrow mb-1">Share feedback</p><h2 class="text-2xl font-bold">Add a review</h2><%= form_with model: [@property, Review.new], class: "mt-5" do |f| %><div class="grid gap-4 sm:grid-cols-[140px_1fr]"><div><%= f.label :rating, "Rating (1–5)", class: "app-label" %><%= f.number_field :rating, in: 1..5, class: "app-input" %></div><div><%= f.label :comment, class: "app-label" %><%= f.text_area :comment, class: "app-input min-h-24", placeholder: "What stood out about this property?" %></div></div><%= f.submit "Publish review", class: "app-button app-button-primary mt-5 cursor-pointer" %><% end %></section>
</div>
