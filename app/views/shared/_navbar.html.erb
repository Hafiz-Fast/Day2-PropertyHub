<nav class="app-surface sticky top-3 z-40 mx-3 sm:mx-4 mt-3 rounded-2xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <%= link_to root_path, class: "flex items-center gap-2 text-xl font-bold app-brand" do %>
        <span class="inline-grid size-8 place-items-center rounded-xl bg-blue-600 text-sm text-white">PH</span>
        PropertyHub
      <% end %>
      <%= link_to "Properties", properties_path, class: "app-link text-sm font-semibold" %>
      <%= link_to "Favorites", favorites_properties_path, class: "app-link text-sm font-semibold" %>
      <%= link_to "Users", users_path, class: "app-link text-sm font-semibold" %>
    </div>

    <div class="flex items-center gap-3">
      <% if user_signed_in? %>
        <%= link_to "My account", edit_user_registration_path, class: "app-link text-sm font-semibold" %>
        <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "app-button app-button-primary text-sm" %>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "app-link text-sm font-semibold" %>
        <%= link_to "Create account", new_user_registration_path, class: "app-button app-button-primary text-sm" %>
      <% end %>
      <button type="button" class="app-button text-sm" data-action="theme#toggle" aria-label="Toggle color theme"><span data-theme-target="label">Dark mode</span></button>
    </div>
  </div>
</nav>
